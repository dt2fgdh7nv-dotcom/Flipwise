# Database. Leave empty to use the built-in local database (stored in .data/, no installation needed).
# For PostgreSQL (production, or docker compose up -d): postgres://flipwise:flipwise@localhost:5432/flipwise
DATABASE_URL=

# Session encryption secret (pnpm setup generates one automatically)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — Statistics Finland PxWeb (open data). Defaults shown.
# STATFIN_PXWEB_BASE=https://pxdata.stat.fi/PxWeb/api/v1/en/StatFin
# STATFIN_ASHI_TABLE=ashi/statfin_ashi_pxt_13mu.px

# Optional — AI features (phase 3+). The app works without it; AI suggestions switch on when set.
# ANTHROPIC_API_KEY=

# Optional — National Land Survey (Maanmittauslaitos) API key for geocoding/maps.
MML_API_KEY=
